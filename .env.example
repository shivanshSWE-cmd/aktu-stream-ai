# ==============================================================================
# AKTU STREAM AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="AKTU Stream AI"
ENVIRONMENT=development
DEBUG=True

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aktu_stream
REDIS_URL=redis://localhost:6379/0

# Google Gemini API (Two-Stage Verification & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLASSIFIER_CONFIDENCE_THRESHOLD=0.70

# YouTube Data API v3 (Strict Quota: ONLY playlistItems.list & videos.list)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=aktu-stream-videos
S3_REGION_NAME=us-east-1
S3_PUBLIC_URL_PREFIX=http://localhost:9000/aktu-stream-videos

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
